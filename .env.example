# Get your API key from https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=your_api_key_here

# Optional: Streaming Availability API (RapidAPI) for better India coverage
# Sign up at https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
# Free tier: 100 requests/month | Basic: $9.99/month for 10,000 requests
# If not provided, falls back to "Search Streaming Options" button
NEXT_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key_here
