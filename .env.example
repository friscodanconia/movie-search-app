# =============================================================================
# CineMagic Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual API keys
# After creating .env.local, restart your development server: npm run dev
#
# IMPORTANT: Never commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - TMDb API Key
# -----------------------------------------------------------------------------
# Get your free API key from: https://www.themoviedb.org/settings/api
# Steps:
#   1. Create a free TMDb account
#   2. Go to Settings > API
#   3. Request an API key (choose "Developer" option)
#   4. Copy the API Key (v3 auth) here
#
# This is required for all features: movies, TV shows, search, collections, etc.
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL - RapidAPI Key for Streaming Availability
# -----------------------------------------------------------------------------
# Enhanced India streaming coverage (Disney+ Hotstar, Zee5, SonyLIV, etc.)
# Get your key from: https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
#
# Pricing:
#   - Free: 100 requests/month (great for testing)
#   - Basic: $9.99/month for 10,000 requests
#   - Pro: $49.99/month for 100,000 requests
#
# Note: The app works perfectly without this! It's only used as a fallback
# when TMDb has no streaming data. See STREAMING_API_SETUP.md for details.
#
# NEXT_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key_here
